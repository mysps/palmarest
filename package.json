{
  "name": "palma-directory",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/pull-d1.mjs && next build",
    "db:migrate:local": "wrangler d1 migrations apply palma-directory --local",
    "db:migrate:remote": "wrangler d1 migrations apply palma-directory --remote",
    "db:seed:local": "node scripts/build-seed.mjs && wrangler d1 execute palma-directory --local --file db/seed.sql",
    "db:seed:remote": "node scripts/build-seed.mjs && wrangler d1 execute palma-directory --remote --file db/seed.sql",
    "db:pull": "node scripts/pull-d1.mjs",
    "match-google": "node scripts/match-google.mjs",
    "geocode": "node scripts/geocode.mjs",
    "deploy": "npm run build && wrangler pages deploy out"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "marked": "^18.2.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  }
}
